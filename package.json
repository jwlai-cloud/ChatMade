{
  "name": "chatmade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "launch": "node --env-file-if-exists=.env scripts/launch.mjs",
    "package": "npm run build && node --env-file-if-exists=.env scripts/package.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "video:sample": "npm run build && node scripts/capture-demo.mjs",
    "video:live": "npm run build && node scripts/capture-demo.mjs --live"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
